# RTLS reader settings
# If the reader runs on another device, set the backend host IP explicitly.
RTLS_SERVER_URL=http://[IP_ADDRESS]:8000/ingest
RTLS_READER_ID=M501
# 루트 .env의 RTLS_REAL_READER_KEYS에서 이 리더 ID에 해당하는 키.
RTLS_READER_KEY=
# RSSI 중앙값을 내는 수집 창(초). 비우면 5. 실물 배치(비콘 0.2초 간격)에서는 1로 둔다.
RTLS_WINDOW_SEC=1
