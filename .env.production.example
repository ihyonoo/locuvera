# ── DB ──
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://mediledger:change-me-strong@postgres:5432/mediledger_db

# ── Redis (besu compose의 redis 서비스) ──
REDIS_URL=redis://redis:6379/0

# ── Auth ──
AUTH_TOKEN_SECRET=REPLACE-WITH-STRONG-RANDOM   # openssl rand -hex 32
AUTH_TOKEN_TTL_SEC=43200

# ── 공개 URL / CORS ──
APP_PUBLIC_URL=https://mediledger.xyz
CORS_ALLOW_ORIGINS=https://mediledger.xyz

# ── Gmail SMTP (실제 값, 서버에서만) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Google OAuth (실제 값, 서버에서만) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mediledger.xyz/api/auth/google/callback

# ── Cloudflare Tunnel ──
CLOUDFLARE_TUNNEL_TOKEN=

# ── Besu ──
BESU_RPC_URL=http://besu-rpc-node:8545
# 배포자 개인키는 백엔드에 주입하지 말고 계약 배포 시에만 별도로 제공한다.
# 기록자 계정에는 가스 비용 잔액이 필요하다.
BESU_SENDER_PRIVATE_KEY=
BESU_SENDER_ADDRESS=
# 시뮬레이터와 백엔드가 함께 사용하는 임의 키.
RTLS_SIM_KEY=
# 실물 리더 ID와 키의 JSON 매핑. 각 리더의 RTLS_READER_KEY와 일치해야 한다.
RTLS_REAL_READER_KEYS={}
# NTAG 424 DNA 칩 키를 파생하는 마스터키(hex 32자). tools/ntag 개인화에 쓴 값과 같아야 한다.
NTAG_MASTER_KEY=

# ── simulator (simulation/) ──
# 시뮬레이션 staff 계정 5개가 공통으로 쓰는 로그인 비밀번호. 없으면 simulator 컨테이너가 즉시 종료된다.
SIM_STAFF_PASSWORD=change-me-strong
