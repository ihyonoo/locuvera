# simulation/.env — 로컬 개발용. 실제 값으로 채운 뒤 simulation/.env로 저장한다(gitignore됨).
# 홈서버 컨테이너에서는 이 파일 없이 docker-compose의 env_file/environment로 주입된다.

# 백엔드 주소. 홈서버 컨테이너에서는 http://backend:8000.
BACKEND_BASE_URL=http://127.0.0.1:8000
# apply_seed 전용. 시뮬레이터 런타임은 DB에 접근하지 않는다.
DATABASE_URL=postgresql://mediledger:mediledger@localhost:5432/mediledger_db
REDIS_URL=redis://127.0.0.1:6379/0
# 루트 .env의 RTLS_SIM_KEY와 동일한 값.
RTLS_SIM_KEY=
# 시뮬레이션 staff 120계정 공통 비밀번호. 없으면 즉시 종료된다.
SIM_STAFF_PASSWORD=
# 비우면 매 기동이 다른 궤적을 그린다. 값을 주면 재현 가능해진다(디버깅용).
SIM_RANDOM_SEED=
