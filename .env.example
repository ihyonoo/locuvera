# 로컬 개발: docker-compose.dev.yml 의 postgres(user/pw=mediledger, 127.0.0.1:5432)에 접속
DATABASE_URL=postgresql://mediledger:mediledger@localhost:5432/mediledger_db
# POSTGRES_PASSWORD=mediledger   # docker-compose.dev.yml 의 postgres 비밀번호(미설정 시 mediledger)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379/0
# 시뮬레이터와 simulation/.env에 같은 임의 키를 설정한다.
RTLS_SIM_KEY=
# 실물 리더별 임의 키(JSON). 각 라즈베리파이의 RTLS_READER_KEY와 일치해야 한다.
RTLS_REAL_READER_KEYS={}
AUTH_TOKEN_SECRET=change-me-for-shared-dev
AUTH_TOKEN_TTL_SEC=43200

# 가입 없이 둘러보는 데모 로그인 스위치 — false로 두면 /auth/demo-login이 404
# DEMO_LOGIN_ENABLED=true

# 프론트엔드 공개 URL — 인증/재설정 메일 링크 및 OAuth 콜백 후 리다이렉트 기준
APP_PUBLIC_URL=http://localhost:5173

# 이메일/OAuth 토큰 유효 시간(초) — 미설정 시 코드 기본값 사용
# EMAIL_VERIFY_TTL_SEC=86400
# PASSWORD_RESET_TTL_SEC=3600
# OAUTH_STATE_TTL_SEC=600
# OAUTH_HANDOFF_TTL_SEC=120
# OAUTH_PENDING_TTL_SEC=1800

# Gmail SMTP (앱 비밀번호). 비워두면 실제 발송 없이 링크를 서버 로그로 출력(dev 폴백)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth 2.0 (authorization code / redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# NTAG 424 DNA 마스터키 (AES-128, hex 32자)
# 생성: python3 -c "import secrets; print(secrets.token_hex(16))"
NTAG_MASTER_KEY=

# Besu 사용 기록용 키. 공개된 개발용 키는 거부된다.
BESU_DEPLOYER_PRIVATE_KEY=
BESU_SENDER_PRIVATE_KEY=
BESU_SENDER_ADDRESS=
